<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="financial_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_co.financial.report.wizard.form</field>
        <field name="model">l10n_co.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Estados financieros colombianos">
                <group>
                    <field name="statement_type" string="Estado financiero" />
                    <field name="company_id" string="Compañía" options="{'no_create': True}" />
                    <field name="date_from" string="Fecha inicial" />
                    <field name="date_to" string="Fecha final" />
                    <field name="comparison" string="Comparar con el año anterior" />
                    <field name="target_move" string="Asientos" />
                </group>
                <footer>
                    <button name="button_export_html" string="Visualizar" type="object" class="oe_highlight" />
                    <button name="button_export_pdf" string="Descargar PDF" type="object" />
                    <button name="button_export_xlsx" string="Descargar Excel" type="object" />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="financial_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Estados financieros colombianos</field>
        <field name="res_model">l10n_co.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="financial_report_wizard_form" />
        <field name="target">new</field>
    </record>
    <record id="financial_report_menu" model="ir.ui.menu">
        <field name="name">Colombia</field>
        <field name="parent_id" ref="account.menu_finance_reports" />
        <field name="action" eval="False" />
        <field name="sequence">80</field>
    </record>
    <record id="wizard_action_bs" model="ir.actions.act_window">
        <field name="name">Estado de Situación Financiera</field>
        <field name="res_model">l10n_co.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="financial_report_wizard_form" />
        <field name="context">{'default_statement_type': 'bs'}</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_bs" name="Estado de Situación Financiera" parent="financial_report_menu" action="wizard_action_bs" groups="account.group_account_manager" sequence="1" />
    <record id="wizard_action_pl" model="ir.actions.act_window">
        <field name="name">Estado de Resultado Integral</field>
        <field name="res_model">l10n_co.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="financial_report_wizard_form" />
        <field name="context">{'default_statement_type': 'pl'}</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_pl" name="Estado de Resultado Integral" parent="financial_report_menu" action="wizard_action_pl" groups="account.group_account_manager" sequence="2" />
    <record id="wizard_action_equity" model="ir.actions.act_window">
        <field name="name">Estado de Cambios en el Patrimonio</field>
        <field name="res_model">l10n_co.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="financial_report_wizard_form" />
        <field name="context">{'default_statement_type': 'equity', 'default_comparison': False}</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_equity" name="Estado de Cambios en el Patrimonio" parent="financial_report_menu" action="wizard_action_equity" groups="account.group_account_manager" sequence="3" />
</odoo>
