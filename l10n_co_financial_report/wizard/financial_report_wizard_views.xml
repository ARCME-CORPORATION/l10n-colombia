<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="financial_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_co.financial.report.wizard.form</field>
        <field name="model">l10n_co.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Colombian Financial Statements">
                <group>
                    <field name="company_id" options="{'no_create': True}" />
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="comparison" />
                </group>
                <p>Review account categories and equity movements before issuing statements.</p>
                <footer>
                    <button name="action_create_reports" type="object" string="Create reports" class="oe_highlight" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="financial_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Colombian Financial Statements</field>
        <field name="res_model">l10n_co.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="financial_report_menu" name="Colombian Financial Statements"
        parent="account.menu_finance_reports" action="financial_report_wizard_action"
        groups="account.group_account_manager" sequence="80" />
</odoo>
