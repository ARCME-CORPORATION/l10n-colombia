<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_account_form" model="ir.ui.view">
        <field name="name">account.account.form.colombian.statements</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="l10n_co_statement_category" />
            </field>
        </field>
    </record>
    <record id="account_account_list" model="ir.ui.view">
        <field name="name">account.account.list.colombian.statements</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="l10n_co_statement_category" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
