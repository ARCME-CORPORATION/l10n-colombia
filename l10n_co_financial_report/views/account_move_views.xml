<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_form" model="ir.ui.view">
        <field name="name">account.move.form.colombian.equity</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='other_tab_entry_group']/group[@name='misc_group']" position="inside">
                <field name="l10n_co_equity_movement" invisible="move_type != 'entry'" />
            </xpath>
        </field>
    </record>
</odoo>
