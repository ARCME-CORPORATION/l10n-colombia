<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="statement_bs"><t t-call="l10n_co_financial_report.financial_statement" /></template>
    <template id="statement_pl"><t t-call="l10n_co_financial_report.financial_statement" /></template>
    <template id="statement_equity"><t t-call="l10n_co_financial_report.financial_statement" /></template>
    <template id="financial_statement">
        <t t-call="account_financial_report.html_container">
            <t t-set="title" t-value="statement['title'] + ' - ' + statement['company'].name + ' - ' + statement['currency'].name" />
            <t t-foreach="statement['sections']" t-as="section">
                <t t-call="account_financial_report.internal_layout">
                    <div class="page" t-att-style="'page-break-after: always;' if not section_last else None">
                        <div class="row">
                            <h4 class="mt0" style="text-align: center;" t-out="title" />
                        </div>
                        <div class="act_as_table data_table">
                            <div class="act_as_row labels">
                                <div class="act_as_cell">NIT</div>
                                <div class="act_as_cell">Período</div>
                                <div class="act_as_cell">Asientos</div>
                            </div>
                            <div class="act_as_row">
                                <div class="act_as_cell" t-out="statement['company'].vat or ''" />
                                <div class="act_as_cell">
                                    <t t-if="section['period']" t-out="section['period']" />
                                    <t t-elif="docs.statement_type == 'bs'">Al <span t-out="statement['date_to']" /></t>
                                    <t t-else="">Del <span t-out="statement['date_from']" /> al <span t-out="statement['date_to']" /></t>
                                </div>
                                <div class="act_as_cell" t-out="'Incluye asientos en borrador' if statement['drafts'] else 'Asientos publicados'" />
                            </div>
                        </div>
                        <div class="act_as_table data_table" style="margin-top: 10px;">
                            <div class="act_as_thead">
                                <div class="act_as_row labels">
                                    <div class="act_as_cell left" t-att-style="'width: 27%;' if statement['equity'] else 'width: 58%;'">Concepto</div>
                                    <div class="act_as_cell" t-foreach="section['columns']" t-as="column" t-out="column" t-att-style="'width: ' + str((73 if statement['equity'] else 42) / len(section['columns'])) + '%;'" />
                                </div>
                            </div>
                            <div class="act_as_tbody">
                                <div t-foreach="section['rows']" t-as="row" t-att-class="'act_as_row account_title labels' if row['header'] else ('act_as_row account_title' if row['total'] else 'act_as_row lines')">
                                    <div class="act_as_cell left"><span t-out="row['name']" t-att-res-model="'account.move.line' if row['domain'] and not row['header'] else None" t-att-domain="row['domain'] if row['domain'] and not row['header'] else None" title="Ver movimientos contables" /></div>
                                    <div class="act_as_cell amount" t-foreach="row['formatted']" t-as="amount"><span t-if="not row['header']" t-out="amount" t-att-res-model="'account.move.line' if row['domains'][amount_index] else None" t-att-domain="row['domains'][amount_index] or None" title="Ver movimientos contables" /></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
